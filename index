<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>MaceCoffee | Premium Coffee</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#faf7f2;
    color:#21170f;
}

/* NAVBAR */

header{
    width:100%;
    position:fixed;
    top:0;
    left:0;
    z-index:1000;

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:18px 7%;

    background:rgba(250,247,242,.94);
    backdrop-filter:blur(10px);

    border-bottom:1px solid #e8ded2;
}

.logo{
    font-size:25px;
    font-weight:800;
    color:#2a1a10;
    text-decoration:none;
}

.logo span{
    color:#9b5d30;
}

nav{
    display:flex;
    gap:30px;
}

nav a{
    color:#3e3026;
    text-decoration:none;
    font-size:14px;
    font-weight:600;
}

nav a:hover{
    color:#9b5d30;
}

.nav-btn{
    background:#21170f;
    color:white !important;
    padding:11px 18px;
    border-radius:25px;
}

.menu{
    display:none;
    font-size:28px;
    cursor:pointer;
}


/* HERO */

.hero{
    min-height:100vh;

    display:grid;
    grid-template-columns:1fr 1fr;
    align-items:center;

    gap:50px;

    padding:120px 8% 70px;
}

.hero-text small{
    color:#9b5d30;
    text-transform:uppercase;
    letter-spacing:3px;
    font-weight:bold;
}

.hero h1{
    font-family:Georgia,serif;
    font-size:clamp(55px,7vw,90px);
    line-height:.98;
    margin:22px 0;
}

.hero h1 span{
    color:#9b5d30;
}

.hero p{
    max-width:520px;
    color:#76695e;
    line-height:1.8;
    font-size:16px;
}

.buttons{
    margin-top:30px;
    display:flex;
    gap:18px;
    align-items:center;
}

.btn{
    display:inline-block;
    padding:15px 25px;
    border-radius:30px;
    text-decoration:none;
    font-weight:bold;
    font-size:13px;
}

.btn-dark{
    background:#21170f;
    color:white;
}

.btn-light{
    border:1px solid #21170f;
    color:#21170f;
}

.btn:hover{
    transform:translateY(-3px);
}


/* COFFEE ART */

.coffee-area{
    min-height:500px;

    display:flex;
    justify-content:center;
    align-items:center;

    position:relative;

    background:linear-gradient(145deg,#ead9c5,#b47b4f);

    border-radius:50% 50% 15px 15px;
    overflow:hidden;
}

.sun{
    position:absolute;

    width:350px;
    height:350px;

    background:#e4b56f;
    opacity:.5;

    border-radius:50%;
}

.cup{
    position:relative;
    z-index:3;

    width:230px;
    height:160px;

    background:#f7eee3;

    border-radius:15px 15px 80px 80px;

    box-shadow:0 25px 30px rgba(50,25,10,.25);
}

.coffee{
    position:absolute;

    width:195px;
    height:48px;

    left:18px;
    top:-12px;

    background:#432315;

    border:8px solid #eadcca;

    border-radius:50%;
}

.handle{
    position:absolute;

    width:75px;
    height:90px;

    right:-65px;
    top:28px;

    border:18px solid #f7eee3;
    border-left:0;

    border-radius:0 50% 50% 0;
}

.saucer{
    position:absolute;

    width:330px;
    height:45px;

    bottom:105px;

    background:#eaded0;

    border-radius:50%;

    z-index:2;
}

.steam{
    position:absolute;

    width:30px;
    height:100px;

    border-left:3px solid rgba(255,255,255,.7);

    border-radius:50%;

    top:110px;

    z-index:5;
}

.steam1{
    left:43%;
}

.steam2{
    left:50%;
    top:90px;
}

.steam3{
    left:57%;
}


/* STATS */

.stats{
    background:#21170f;
    color:white;

    display:grid;
    grid-template-columns:repeat(4,1fr);

    padding:30px 8%;
}

.stat{
    text-align:center;
    border-right:1px solid #ffffff20;
}

.stat:last-child{
    border:0;
}

.stat h3{
    font-family:Georgia,serif;
    font-size:30px;
}

.stat p{
    color:#bdb0a5;
    font-size:11px;
    margin-top:5px;
}


/* COMMON */

section{
    padding:100px 8%;
}

.title{
    text-align:center;
    max-width:700px;
    margin:0 auto 55px;
}

.title small{
    color:#9b5d30;
    text-transform:uppercase;
    letter-spacing:3px;
    font-weight:bold;
}

.title h2{
    font-family:Georgia,serif;
    font-size:55px;
    margin-top:15px;
}

.title h2 span{
    color:#9b5d30;
}


/* STORY */

.story{
    display:grid;
    grid-template-columns:1fr 1fr;

    gap:80px;

    align-items:center;
}

.story-image{
    height:470px;

    background:linear-gradient(145deg,#dfc5a8,#956643);

    display:flex;
    justify-content:center;
    align-items:center;
}

.bag{
    width:180px;
    height:250px;

    background:#2c211a;
    color:#f7e9d8;

    display:flex;
    justify-content:center;
    align-items:center;

    text-align:center;

    font-family:Georgia,serif;
    font-size:35px;

    transform:rotate(-6deg);

    box-shadow:20px 25px 30px rgba(0,0,0,.2);
}

.story-text small{
    color:#9b5d30;
    font-weight:bold;
    letter-spacing:3px;
}

.story-text h2{
    font-family:Georgia,serif;
    font-size:55px;
    line-height:1.05;

    margin:18px 0;
}

.story-text h2 span{
    color:#9b5d30;
}

.story-text p{
    color:#76695e;
    line-height:1.9;
    margin-bottom:25px;
}


/* PRODUCTS */

.products{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.card{
    background:white;
    border:1px solid #e5ddd4;
    transition:.3s;
}

.card:hover{
    transform:translateY(-8px);
    box-shadow:0 20px 40px rgba(50,30,15,.1);
}

.card-img{
    height:260px;

    display:flex;
    justify-content:center;
    align-items:center;
}

.card:nth-child(1) .card-img{
    background:#dfc5a8;
}

.card:nth-child(2) .card-img{
    background:#d5c5b7;
}

.card:nth-child(3) .card-img{
    background:#bda795;
}

.mini-cup{
    width:120px;
    height:80px;

    background:#f4eadf;

    border-radius:10px 10px 45px 45px;

    box-shadow:0 15px 20px rgba(0,0,0,.2);

    position:relative;
}

.mini-cup:before{
    content:"";

    position:absolute;

    width:100px;
    height:25px;

    left:10px;
    top:-8px;

    background:#402314;

    border-radius:50%;

    border:5px solid #e9dbca;
}

.card-body{
    padding:25px;
}

.card-body small{
    color:#9b5d30;
    font-weight:bold;
    font-size:10px;
}

.card-body h3{
    font-family:Georgia,serif;
    font-size:28px;
    margin:7px 0;
}

.card-body p{
    color:#76695e;
    font-size:13px;
    line-height:1.6;
}

.price{
    margin-top:20px;

    display:flex;
    justify-content:space-between;
    align-items:center;
}

.price strong{
    font-family:Georgia,serif;
    font-size:20px;
}

.cart{
    border:0;
    border-bottom:1px solid #21170f;

    background:none;

    padding-bottom:3px;

    cursor:pointer;

    font-weight:bold;
}


/* WHY */

.why{
    background:#f0e7dc;
}

.features{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:50px;

    max-width:1100px;
    margin:auto;
}

.feature{
    text-align:center;
}

.feature-number{
    color:#9b5d30;
    font-weight:bold;
    font-size:13px;
}

.feature h3{
    font-family:Georgia,serif;
    font-size:27px;
    margin:12px 0;
}

.feature p{
    color:#76695e;
    line-height:1.7;
    font-size:13px;
}


/* CTA */

.cta{
    margin:90px 8%;

    padding:75px;

    background:#21170f;
    color:white;

    display:flex;
    justify-content:space-between;
    align-items:center;

    border-radius:4px;
}

.cta h2{
    font-family:Georgia,serif;
    font-size:55px;
    line-height:1;
}

.cta h2 span{
    color:#c18455;
}

.cta p{
    color:#bdb0a5;
    margin-bottom:20px;
}


/* FOOTER */

footer{
    padding:45px 8%;

    border-top:1px solid #e1d9d0;

    display:flex;
    justify-content:space-between;
    align-items:center;
}

footer p{
    color:#76695e;
    font-size:12px;
}

.social{
    display:flex;
    gap:20px;
}

.social a{
    color:#21170f;
    font-weight:bold;
    font-size:12px;
}


/* TOAST */

.toast{
    position:fixed;

    right:25px;
    bottom:25px;

    background:#21170f;
    color:white;

    padding:14px 20px;

    border-radius:8px;

    opacity:0;

    transform:translateY(20px);

    transition:.3s;

    z-index:2000;

    font-size:13px;
}

.toast.show{
    opacity:1;
    transform:translateY(0);
}


/* MOBILE */

@media(max-width:850px){

    header{
        padding:16px 5%;
    }

    nav{
        display:none;

        position:absolute;

        top:70px;
        left:5%;
        right:5%;

        background:white;

        padding:25px;

        flex-direction:column;

        gap:20px;

        box-shadow:0 15px 35px rgba(0,0,0,.1);
    }

    nav.active{
        display:flex;
    }

    .nav-btn{
        text-align:center;
    }

    .menu{
        display:block;
    }

    .hero{
        grid-template-columns:1fr;

        padding:120px 5% 60px;
    }

    .hero h1{
        font-size:58px;
    }

    .coffee-area{
        min-height:430px;
    }

    .stats{
        grid-template-columns:repeat(2,1fr);
        gap:20px;
    }

    .stat{
        border:0;
    }

    .story{
        grid-template-columns:1fr;
        gap:45px;
    }

    .story-text h2{
        font-size:45px;
    }

    .products{
        grid-template-columns:1fr;
    }

    .features{
        grid-template-columns:1fr;
    }

    .title h2{
        font-size:43px;
    }

    .cta{
        margin:50px 5%;
        padding:45px 30px;

        display:block;
    }

    .cta h2{
        font-size:45px;
    }

    .cta-right{
        margin-top:30px;
    }

    footer{
        flex-direction:column;
        gap:20px;
        text-align:center;
    }

}

</style>
</head>


